{
    "name": "helios",
    "displayName": "Helios",
    "description": "Helios language support for VS Code",
    "publisher": "HeliosLang",
    "version": "0.1.8",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/hyperion-bt/helios-ide-plugins"
    },
    "scripts": {
        "build": "tsc && vsce package --no-dependencies",
        "postinstall": "pnpm run build ; pnpm run package",
        "package": "vsce package --no-dependencies && code --install-extension ./helios-0.1.8.vsix ; true",
        "deploy": "vsce publish"
    },
    "engines": {
        "vscode": "^1.77.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "helios",
                "aliases": [
                    "helios",
                    "Helios",
                    "Helios-Lang",
                    "Helios-lang",
                    "Helios_lang",
                    "helios_lang"
                ],
                "extensions": [
                    ".hl",
                    ".helios"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "file-icon-light.png",
                    "dark": "file-icon-dark.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "helios",
                "scopeName": "source.helios",
                "path": "./grammar.json"
            }
        ],
        "debuggers": [
            {
                "type": "helios",
                "label": "Helios Debugger",
                "languages": ["helios"],
                "configurationAttributes": { "launch": { "properties": {} } }
            }
        ],
        "viewsWelcome": [
            {
                "view": "debug",
                "contents": "",
                "when": "!virtualWorkspace && debugStartLanguage == helios"
            }
        ],
        "views": {
            "debug": [
                {
                    "type": "webview",
                    "id": "helios.runView",
                    "name": "Helios Entry Point & Arguments",
                    "visibility": "visible",
                    "when": "!virtualWorkspace && debugStartLanguage == helios"
                }
            ]
        },
        "commands": [
            {
                "command": "helios.showRunView"
            }
        ]
    },
    "main": "./dist/index.js",
    "activationEvents": [
        "onLanguage:helios",
        "onView:helios.runView",
        "onCommand:helios.showRunView",
        "onDebugInitialConfigurations",
        "onDebugDynamicConfigurations:helios",
        "onDebugResolve:helios"
    ],
    "dependencies": {
        "@vscode/vsce": "^3.0.0",
        "vscode-nls": "^5.2.0"
    },
    "devDependencies": {
        "@types/node": "^18.15.11",
        "@types/vscode": "^1.77.0",
        "typescript": "^5.0.4"
    }
}
