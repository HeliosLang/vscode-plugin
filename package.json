{
    "name": "helios",
    "displayName": "Helios",
    "description": "Helios language support for VS Code",
    "publisher": "HeliosLang",
    "version": "0.1.8",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/hyperion-bt/helios-ide-plugins"
    },
    "scripts": {
        "build": "pnpm run test:types && node ./esbuild.mjs && vsce package --no-dependencies",
        "deploy": "vsce publish",
        "package": "vsce package --no-dependencies && code --install-extension ./helios-0.1.8.vsix ; true",
        "postinstall": "pnpm run build ; pnpm run package",
        "prettify": "prettier . --write",
        "test": "pnpm run test:types",
        "test:types": "tsc --noEmit"
    },
    "engines": {
        "vscode": "^1.77.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "helios",
                "aliases": [
                    "helios",
                    "Helios",
                    "Helios-Lang",
                    "Helios-lang",
                    "Helios_lang",
                    "helios_lang"
                ],
                "extensions": [
                    ".hl",
                    ".helios"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "file-icon-light.png",
                    "dark": "file-icon-dark.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "helios",
                "scopeName": "source.helios",
                "path": "./grammar.json"
            }
        ],
        "debuggers": [
            {
                "type": "helios",
                "label": "Helios Debugger",
                "program": "./dist/debugAdapter.js",
                "languages": [
                    "helios"
                ],
                "configurationAttributes": {
                    "launch": {
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "Name of the helios debug session",
                                "default": "Hello world"
                            }
                        },
                        "required": [
                            "name"
                        ]
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "helios",
                        "request": "launch",
                        "name": "Launch Helios Debugger"
                    }
                ]
            }
        ],
        "viewsWelcome": [
            {
                "view": "debug",
                "contents": "",
                "when": "!virtualWorkspace && debugStartLanguage == helios"
            }
        ],
        "views": {
            "debug": [
                {
                    "type": "webview",
                    "id": "helios.entryPointAndArguments",
                    "name": "Helios Entry Point & Arguments",
                    "visibility": "visible",
                    "when": "!virtualWorkspace && debugStartLanguage == helios"
                }
            ]
        },
        "commands": [
            {
                "title": "Show Helios Entry Point & Arguments View",
                "command": "helios.showEntryPointAndArguments"
            }
        ]
    },
    "main": "./dist/index.js",
    "activationEvents": [
        "onDebugInitialConfigurations",
        "onDebugDynamicConfigurations:helios",
        "onDebugResolve:helios"
    ],
    "prettier": {
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": false
    },
    "dependencies": {
        "@vscode/debugadapter": "^1.68.0",
        "@vscode/debugprotocol": "^1.68.0",
        "@vscode/vsce": "^3.0.0",
        "vscode-nls": "^5.2.0"
    },
    "devDependencies": {
        "@helios-lang/codec-utils": "^0.3.4",
        "@helios-lang/compiler": "^0.17.22",
        "@helios-lang/compiler-utils": "^0.5.16",
        "@helios-lang/crypto": "^0.2.3",
        "@types/node": "^18.15.11",
        "@types/vscode": "^1.77.0",
        "esbuild": "^0.25.9",
        "prettier": "^3.6.2",
        "typescript": "^5.0.4"
    }
}
