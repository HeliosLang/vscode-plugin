{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Helios Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "preLaunchTask": "build with esbuild"
        }
    ]
}
