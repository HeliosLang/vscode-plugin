{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build with esbuild",
            "type": "shell",
            "command": "pnpm -C ${workspaceFolder} run build",
            "problemMatcher": []
        },
        {
            "label": "package with vsce",
            "type": "shell",
            "command": "vsce package --no-dependencies",
            "problemMatcher": []
        },
        {
            "label": "install with code",
            "type": "shell",
            "command": "code --install-extension ./helios-0.2.0.vsix",
            "problemMatcher": []
        },
        {
            "label": "prelaunch",
            "dependsOn": ["build with esbuild"],
            "dependsOrder": "sequence",
            "group": "build"
        }
    ]
}
